# Copy to .env.local after creating a Supabase project. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private account email; login never creates users.
OWNER_EMAIL=
APP_URL=http://localhost:3000
# Optional future screenshot extraction; not required for manual recording.
OPENAI_API_KEY=
OPENAI_MODEL=
# Local development only. Prefer pnpm dev:demo; never enable on hosted deployments.
BET_TRACKER_DEMO=false
