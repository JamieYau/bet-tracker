# Copy to .env.local. Never commit real credentials.
# Server-only runtime connection: a separate restricted PostgreSQL login role.
DATABASE_URL=
# Operator scripts only. Do not set this on the hosted Next.js application.
MIGRATION_DATABASE_URL=
RUNTIME_DATABASE_ROLE=bet_tracker_app
# Generate a random secret of at least 32 characters. Keep it server-side.
BETTER_AUTH_SECRET=
OWNER_EMAIL=
# Exact browser origin. HTTPS on hosted environments; loopback HTTP locally.
APP_URL=http://localhost:3000
# Optional future screenshot extraction; not required for manual recording.
OPENAI_API_KEY=
OPENAI_MODEL=
# Local development only. Prefer pnpm dev:demo; never enable on hosted deployments.
BET_TRACKER_DEMO=false
