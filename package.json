{
  "name": "bet-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "biome check . && pnpm typecheck",
    "dev:demo": "BET_TRACKER_DEMO=true next dev --hostname 127.0.0.1",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "drizzle-kit check",
    "test:db:modular": "vitest run tests/integration/modular-schema.test.ts",
    "owner:provision": "tsx scripts/owner.ts provision",
    "owner:recover": "tsx scripts/owner.ts recover",
    "db:grant-runtime": "tsx scripts/db-grants.ts",
    "test:e2e:auth": "tsx scripts/test-auth-e2e.ts",
    "db:verify": "tsx scripts/db-verify.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@next/env": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
